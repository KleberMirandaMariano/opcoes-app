# ==================== PROVEDORES DE DADOS ====================
# Ordem de prioridade: RB3 (principal) → Brapi → HG Brasil → Mock local
# Sem nenhuma config, o app usa dados mock.

# RB3 API (PRINCIPAL): Dados em tempo real da B3
# Deixe em branco se não estiver rodando a API RB3 localmente
RB3_ENABLED=true
RB3_API_URL=http://localhost:3002

# Brapi (fallback): ações, índices, fundamentos, histórico, lista altas/baixas
# Obtenha em: https://brapi.dev/dashboard
# Sem token: só PETR4, VALE3, ITUB4, MGLU3 funcionam com dados reais
BRAPI_TOKEN=seu_token_aqui

# HG Brasil (failover): índices, moedas, cotações de ações (requer plano Member)
# Obtenha em: https://console.hgbrasil.com/keys
HGBRASIL_KEY=sua_chave_aqui

# ==================== SERVIDOR ====================
PORT=3001
NODE_ENV=development

# ==================== SEGURANÇA ====================
# IMPORTANTE: Mude em produção com uma chave forte
SESSION_SECRET=mude_isto_em_producao_com_uma_chave_forte

# Origens permitidas para CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# ==================== CACHE ====================
# TTL em segundos para cache de dados de mercado
CACHE_TTL=300
